# Intentionally undefined user.name and user.email, since this file is 
# shared across different roles. These should be set up using the NAME and
# EMAIL environment variables instead.

[user]
    name = "Geoff Hulette"
    email = {{ .email | quote }}
[core]
    excludesfile = ~/.gitignore
    editor = nvim
[pull]
    rebase = true
[init]
    defaultBranch = main
[alias]
    co = checkout
    ci = commit
    st = status
    br = branch
    hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
    type = cat-file -t
    dump = cat-file -p

# Machine-specific settings (credentials, work remotes); untracked, and git
# skips the include if the file is missing. Last, so it can override the above.
[include]
    path = ~/.gitconfig.local
