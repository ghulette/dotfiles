setopt PROMPT_SUBST
PS1='%B%F{cyan}%3~/%B%(?.%F{green}❯%f.%F{red}✗%f)%b '

# Configure history
HISTFILE=~/.zhistory
HISTSIZE=1000
SAVEHIST=1000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS

# Autocompletion using arrow keys (based on history)
bindkey '\e[A' history-search-backward
bindkey '\e[B' history-search-forward

# Word movement with Alt+arrow and Ctrl+arrow
bindkey '\e[1;3C' forward-word
bindkey '\e[1;3D' backward-word
bindkey '\e[1;5C' forward-word
bindkey '\e[1;5D' backward-word

# Some nice options
setopt autocd beep extendedglob nomatch notify

# Use emacs keybindings
bindkey -e

# Completion
zstyle :compinstall filename '/Users/ghulette/.zshrc'
autoload -Uz compinit
compinit
setopt globdots
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "/Users/ghulette/.zcompcache"
zstyle ':completion:*' menu select search interactive

# Load local configuration, if available
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin":$PATH
[ -f "$HOME/.zshrc_local" ] && source "$HOME/.zshrc_local"
[ -d "$HOME/.elan" ] && export PATH="$HOME/.elan/bin:$PATH"

# Add aliases only after updating path
if command -v eza &> /dev/null; then
  alias ls='eza --icons auto'
fi

# AIM CLI (only if installed)
if [ -d "$HOME/.aim/mcp-servers" ]; then
  export PATH="$HOME/.aim/mcp-servers:$PATH"
fi

# Cloud desktop management appends the next lines to ~/.zshrc whenever
# they are missing, so keep them here verbatim to stop it editing this file.
# Harmless elsewhere: it only stops AWS SDKs probing for EC2 instance metadata.
# if you wish to use IMDS set AWS_EC2_METADATA_DISABLED=false

export AWS_EC2_METADATA_DISABLED=true

# Warn when notes-sync (cron; ~/.local/bin/notes-sync) has stopped working:
# a failure with no successful sync for 30 minutes (so one-off blips stay
# quiet), or no successful sync at all for a day (cron not running?). Silent
# on machines where it isn't set up, since neither status file exists there.
() {
  local ok=~/.cache/notes-sync.ok err=~/.cache/notes-sync.err
  local -a recent=( $ok(N.mm-30) ) today=( $ok(N.mh-24) )
  if [[ -e $err && -z $recent ]]; then
    print -nP "%F{yellow}notes-sync:%f "; print -r -- "$(<$err)"
  elif [[ -e $ok && -z $today ]]; then
    print -nP "%F{yellow}notes-sync:%f "; print -r -- "no successful sync since $(<$ok) (is cron running?)"
  fi
}
